<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.jake.advance-roadmap-leaderboard</string>

	<!-- Records Jake's Production Run standing (leaderboard.me) once a day, whether or not the
	     roadmap batch or the dashboard ran, and fills in any ended day's final single-day rank
	     that's missing (lib/leaderboard.py snapshot). 18:50 local is just before the UTC day
	     ends (00:00 UTC is 19:00 EST / 20:00 EDT), so "today" is close to its final value.
	     If the Mac is asleep then, launchd runs it on wake. Install / reload:
	       cp com.jake.advance-roadmap-leaderboard.plist ~/Library/LaunchAgents/
	       launchctl bootout gui/$(id -u)/com.jake.advance-roadmap-leaderboard
	       launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.jake.advance-roadmap-leaderboard.plist -->
	<key>ProgramArguments</key>
	<array>
		<string>/opt/homebrew/bin/python3</string>
		<string>/Users/jake/.claude/automations/advance-roadmap/lib/leaderboard.py</string>
		<string>snapshot</string>
		<string>--force</string>
	</array>

	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key><integer>18</integer>
		<key>Minute</key><integer>50</integer>
	</dict>

	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin:/Users/jake/.local/bin</string>
	</dict>

	<key>RunAtLoad</key>
	<false/>

	<key>ProcessType</key>
	<string>Background</string>

	<key>StandardOutPath</key>
	<string>/Users/jake/.claude/automations/advance-roadmap/logs/leaderboard.out.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/jake/.claude/automations/advance-roadmap/logs/leaderboard.err.log</string>
</dict>
</plist>
