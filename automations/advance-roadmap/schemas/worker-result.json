{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AdvanceRoadmapWorkerResult",
  "type": "object",
  "required": ["outcome", "provider"],
  "allOf": [{"if": {"properties": {"outcome": {"const": "yielded"}}, "required": ["outcome"]},
             "then": {"required": ["next_phase"]}, "else": {"required": ["summary"]}}],
  "properties": {
    "outcome": {
      "type": "string",
      "enum": ["shipped", "shipped-deploy-failed", "blocked-branch-left", "failed", "limit_hit", "yielded", "archive-only", "bookkeeping"]
    },
    "provider": {
      "type": "string",
      "enum": ["cursor", "codex", "claude"]
    },
    "repo": { "type": ["string", "null"] },
    "item": { "type": ["string", "null"] },
    "branch": { "type": ["string", "null"] },
    "merge_commit": { "type": ["string", "null"] },
    "pr_url": { "type": ["string", "null"] },
    "linear_id": { "type": ["string", "null"] },
    "worker_mode": {
      "type": "string",
      "enum": ["standard", "goal"]
    },
    "next_phase": {
      "type": ["string", "null"],
      "enum": ["implementing", "reviewing", "shipping", "verifying", null]
    },
    "work_kind": {
      "type": "string",
      "enum": ["feature"]
    },
    "limit_text": { "type": ["string", "null"] },
    "deploy": {
      "type": ["object", "null"],
      "properties": {
        "status": { "type": "string", "enum": ["success", "failed", "timeout", "none"] },
        "url": { "type": ["string", "null"] },
        "attempts": { "type": "integer", "minimum": 0 }
      }
    },
    "review": {
      "type": ["object", "null"],
      "properties": {
        "reviewer": { "type": ["string", "null"], "enum": ["cursor", "codex", "claude", null] },
        "rounds": { "type": "integer", "minimum": 0 },
        "unresolved": { "type": "integer", "minimum": 0 }
      }
    },
    "needs_input": { "type": "boolean", "default": false },
    "input_question": { "type": ["string", "null"] },
    "summary": { "type": "string" },
    "slack_summary": { "type": ["string", "null"] }
  }
}
