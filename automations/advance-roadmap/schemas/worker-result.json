{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AdvanceRoadmapWorkerResult",
  "type": "object",
  "required": ["outcome", "provider", "summary"],
  "properties": {
    "outcome": {
      "type": "string",
      "enum": ["shipped", "shipped-deploy-failed", "blocked-branch-left", "failed", "limit_hit", "archive-only", "bookkeeping"]
    },
    "provider": {
      "type": "string",
      "enum": ["cursor", "codex", "claude"]
    },
    "repo": { "type": ["string", "null"] },
    "item": { "type": ["string", "null"] },
    "branch": { "type": ["string", "null"] },
    "merge_commit": { "type": ["string", "null"] },
    "linear_id": { "type": ["string", "null"] },
    "worker_mode": {
      "type": "string",
      "enum": ["standard", "goal"]
    },
    "limit_text": { "type": ["string", "null"] },
    "deploy": {
      "type": ["object", "null"],
      "properties": {
        "status": { "type": "string", "enum": ["success", "failed", "timeout", "none"] },
        "url": { "type": ["string", "null"] },
        "attempts": { "type": "integer", "minimum": 0 }
      }
    },
    "summary": { "type": "string" }
  }
}
