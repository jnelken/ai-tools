<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.jake.advance-roadmap</string>

	<key>ProgramArguments</key>
	<array>
		<string>/opt/homebrew/bin/python3</string>
		<string>/Users/jake/.claude/automations/advance-roadmap/supervisor.py</string>
	</array>

	<!-- Two sprint windows a day, every day: 10:30–15:30 and 16:00–21:00 local. The first tick of a
	     window starts supervisor.py, which runs one parallel lane (run.sh in lane mode) per
	     available repo until the window's dispatch cutoff, and carries straight on into the next
	     window when it opens within the hour. The later ticks are a watchdog: a tick while a
	     supervisor is alive exits at once, and one after a crash starts a fresh supervisor.
	     Nothing fires overnight: lone runs then add one-session slots that drag Superset's width
	     median down (docs/plans/production-run.md). Keep this tick list in step with SPRINT_TICKS
	     in gen-dashboard.py. After editing, reload:
	       cp com.jake.advance-roadmap.plist ~/Library/LaunchAgents/
	       launchctl bootout gui/$(id -u)/com.jake.advance-roadmap
	       launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.jake.advance-roadmap.plist -->
	<key>StartCalendarInterval</key>
	<array>
		<dict><key>Hour</key><integer>10</integer><key>Minute</key><integer>30</integer></dict>
		<dict><key>Hour</key><integer>11</integer><key>Minute</key><integer>30</integer></dict>
		<dict><key>Hour</key><integer>12</integer><key>Minute</key><integer>30</integer></dict>
		<dict><key>Hour</key><integer>13</integer><key>Minute</key><integer>30</integer></dict>
		<dict><key>Hour</key><integer>14</integer><key>Minute</key><integer>30</integer></dict>
		<dict><key>Hour</key><integer>16</integer><key>Minute</key><integer>0</integer></dict>
		<dict><key>Hour</key><integer>17</integer><key>Minute</key><integer>0</integer></dict>
		<dict><key>Hour</key><integer>18</integer><key>Minute</key><integer>0</integer></dict>
		<dict><key>Hour</key><integer>19</integer><key>Minute</key><integer>0</integer></dict>
		<dict><key>Hour</key><integer>20</integer><key>Minute</key><integer>0</integer></dict>
	</array>

	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/opt/homebrew/opt/node@22/bin:/usr/bin:/bin:/usr/sbin:/sbin:/Users/jake/.local/bin</string>
		<key>ADVANCE_ROADMAP_CADENCE_HOURS</key>
		<string>1</string>
		<!-- The sprint windows. A tick launchd fires late (on wake) outside them does nothing. -->
		<key>ADVANCE_ROADMAP_WINDOWS</key>
		<string>10:30-15:30 16:00-21:00</string>
		<!-- Most lanes at once; in practice it's as many as there are repos with work. -->
		<key>ADVANCE_ROADMAP_LANES</key>
		<string>8</string>
	</dict>

	<key>RunAtLoad</key>
	<false/>

	<key>ProcessType</key>
	<string>Background</string>

	<key>StandardOutPath</key>
	<string>/Users/jake/.claude/automations/advance-roadmap/logs/launchd.out.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/jake/.claude/automations/advance-roadmap/logs/launchd.err.log</string>
</dict>
</plist>
