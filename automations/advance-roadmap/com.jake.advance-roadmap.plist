<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.jake.advance-roadmap</string>

	<key>ProgramArguments</key>
	<array>
		<string>/bin/zsh</string>
		<string>/Users/jake/.claude/automations/advance-roadmap/run.sh</string>
	</array>

	<!-- Fires every hour at :45; run.sh decides which ticks run. The base cadence is
	     ADVANCE_ROADMAP_CADENCE_HOURS below (a divisor of 24): slots are the hours where
	     (hour - 3) is a multiple of it, so 2h → 1:45, 3:45 … 11:45pm. That grid never lands on
	     2:45, when wrapup-repos commits WIP on Sundays — this job requires a clean tree.
	     Off-slot ticks exit silently. If the Mac is asleep at a scheduled time, launchd runs
	     the missed job on wake. Edit the value, then reload:
	       launchctl bootout gui/$(id -u)/com.jake.advance-roadmap
	       launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.jake.advance-roadmap.plist -->
	<key>StartCalendarInterval</key>
	<dict><key>Minute</key><integer>45</integer></dict>

	<key>EnvironmentVariables</key>
	<dict>
		<key>ADVANCE_ROADMAP_CADENCE_HOURS</key>
		<string>2</string>
	</dict>

	<key>RunAtLoad</key>
	<false/>

	<key>ProcessType</key>
	<string>Background</string>

	<key>StandardOutPath</key>
	<string>/Users/jake/.claude/automations/advance-roadmap/logs/launchd.out.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/jake/.claude/automations/advance-roadmap/logs/launchd.err.log</string>
</dict>
</plist>
