<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.jake.advance-roadmap</string>

	<key>ProgramArguments</key>
	<array>
		<string>/bin/zsh</string>
		<string>/Users/jake/.claude/automations/advance-roadmap/run.sh</string>
	</array>

	<!-- Once a day, 4:45am local time (handles DST automatically). Deliberately two
	     hours after wrapup-repos' 2:45am slot: that job commits WIP, and this one
	     requires a clean tree, so it wants to run after — never on top of it.
	     If the Mac is asleep at the scheduled time, launchd runs the missed job on wake. -->
	<key>StartCalendarInterval</key>
	<array>
		<dict><key>Hour</key><integer>4</integer><key>Minute</key><integer>45</integer></dict>
	</array>

	<key>RunAtLoad</key>
	<false/>

	<key>ProcessType</key>
	<string>Background</string>

	<key>StandardOutPath</key>
	<string>/Users/jake/.claude/automations/advance-roadmap/logs/launchd.out.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/jake/.claude/automations/advance-roadmap/logs/launchd.err.log</string>
</dict>
</plist>
