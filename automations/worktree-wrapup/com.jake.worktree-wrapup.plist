<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.jake.worktree-wrapup</string>

	<key>ProgramArguments</key>
	<array>
		<string>/bin/zsh</string>
		<string>/Users/jake/.claude/automations/worktree-wrapup/run.sh</string>
	</array>

	<!-- Off-peak, local time (handles DST automatically): 2:45am, 7:45am, 12:45pm, 5:45pm.
	     If the Mac is asleep at a scheduled time, launchd runs the missed job on wake. -->
	<key>StartCalendarInterval</key>
	<array>
		<dict><key>Hour</key><integer>2</integer><key>Minute</key><integer>45</integer></dict>
		<dict><key>Hour</key><integer>7</integer><key>Minute</key><integer>45</integer></dict>
		<dict><key>Hour</key><integer>12</integer><key>Minute</key><integer>45</integer></dict>
		<dict><key>Hour</key><integer>17</integer><key>Minute</key><integer>45</integer></dict>
	</array>

	<key>RunAtLoad</key>
	<false/>

	<key>ProcessType</key>
	<string>Background</string>

	<key>StandardOutPath</key>
	<string>/Users/jake/.claude/automations/worktree-wrapup/logs/launchd.out.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/jake/.claude/automations/worktree-wrapup/logs/launchd.err.log</string>
</dict>
</plist>
