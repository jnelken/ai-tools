<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.jake.wrapup-repos</string>

	<!-- An automation is a schedule plus a skill name: the work lives in skills/wrapup-repos.
	     $HOME is expanded by sh. The personal code dir differs per machine, so it is resolved at
	     run time; an empty result (no personal repos here) is ignored by skill-automation.
	     Logs go to ~/.claude/automations/wrapup-repos/logs/. -->
	<key>ProgramArguments</key>
	<array>
		<string>/bin/sh</string>
		<string>-c</string>
		<string>exec "$HOME/.ai-tools/bin/skill-automation" wrapup-repos --once-per week --add-dir "$("$HOME/.ai-tools/bin/personal-code-dir" 2>/dev/null)"</string>
	</array>

	<!-- Off-peak, local time (handles DST automatically): once a week, Sunday 2:45am.
	     If the Mac is asleep at the scheduled time, launchd runs the missed job on wake. -->
	<key>StartCalendarInterval</key>
	<dict><key>Weekday</key><integer>0</integer><key>Hour</key><integer>2</integer><key>Minute</key><integer>45</integer></dict>

	<key>RunAtLoad</key>
	<false/>

	<key>ProcessType</key>
	<string>Background</string>
</dict>
</plist>
