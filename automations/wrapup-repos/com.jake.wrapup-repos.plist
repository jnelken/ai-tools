<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.jake.wrapup-repos</string>

	<key>ProgramArguments</key>
	<array>
		<string>/bin/zsh</string>
		<string>/Users/jake/.claude/automations/wrapup-repos/run.sh</string>
	</array>

	<!-- Off-peak, local time (handles DST automatically): once a week, Sunday 2:45am.
	     If the Mac is asleep at the scheduled time, launchd runs the missed job on wake. -->
	<key>StartCalendarInterval</key>
	<dict><key>Weekday</key><integer>0</integer><key>Hour</key><integer>2</integer><key>Minute</key><integer>45</integer></dict>

	<key>RunAtLoad</key>
	<false/>

	<key>ProcessType</key>
	<string>Background</string>

	<key>StandardOutPath</key>
	<string>/Users/jake/.claude/automations/wrapup-repos/logs/launchd.out.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/jake/.claude/automations/wrapup-repos/logs/launchd.err.log</string>
</dict>
</plist>
