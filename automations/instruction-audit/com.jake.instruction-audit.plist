<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.jake.instruction-audit</string>

	<!-- An automation is a schedule plus a skill name: the work lives in skills/instruction-audit.
	     $HOME is expanded by sh, so the plist is the same on every machine. Logs go to
	     ~/.claude/automations/instruction-audit/logs/. -->
	<key>ProgramArguments</key>
	<array>
		<string>/bin/sh</string>
		<string>-c</string>
		<string>exec "$HOME/.ai-tools/bin/skill-automation" instruction-audit --once-per month</string>
	</array>

	<!-- 3:15 am local time on days 1-7 of each month. skill-automation skips once the month has
	     succeeded, so days 2-7 only matter when the Mac was off on the 1st or the run failed.
	     A sleeping Mac runs the missed job on wake. -->
	<key>StartCalendarInterval</key>
	<array>
		<dict><key>Day</key><integer>1</integer><key>Hour</key><integer>3</integer><key>Minute</key><integer>15</integer></dict>
		<dict><key>Day</key><integer>2</integer><key>Hour</key><integer>3</integer><key>Minute</key><integer>15</integer></dict>
		<dict><key>Day</key><integer>3</integer><key>Hour</key><integer>3</integer><key>Minute</key><integer>15</integer></dict>
		<dict><key>Day</key><integer>4</integer><key>Hour</key><integer>3</integer><key>Minute</key><integer>15</integer></dict>
		<dict><key>Day</key><integer>5</integer><key>Hour</key><integer>3</integer><key>Minute</key><integer>15</integer></dict>
		<dict><key>Day</key><integer>6</integer><key>Hour</key><integer>3</integer><key>Minute</key><integer>15</integer></dict>
		<dict><key>Day</key><integer>7</integer><key>Hour</key><integer>3</integer><key>Minute</key><integer>15</integer></dict>
	</array>

	<key>RunAtLoad</key>
	<false/>

	<key>ProcessType</key>
	<string>Background</string>
</dict>
</plist>
