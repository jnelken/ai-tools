#!/usr/bin/env python3
"""Build the public-source plugin archive without personal account bindings."""

import argparse
import json
from pathlib import Path
import re
import zipfile


SKILLS = (
    "unblock-roadmap", "advance-roadmap", "move-diff", "rebase-after-squash",
    "fix-stale-docs", "close-out", "pick-up", "session-hardening",
)
SKILL_LABELS = {
    "unblock-roadmap": ("Unblock Roadmap", "Resolve roadmap decisions one question at a time"),
    "advance-roadmap": ("Advance Roadmap", "Implement and verify one scoped roadmap item"),
    "move-diff": ("Move Diff", "Move uncommitted work between Git worktrees"),
    "rebase-after-squash": ("Rebase After Squash", "Replay child work after a parent squash merge"),
    "fix-stale-docs": ("Fix Stale Docs", "Repair verified stale documentation"),
    "close-out": ("Close Out", "Finish a session and preserve the handoff"),
    "pick-up": ("Pick Up", "Verify and resume a previous session's work"),
    "session-hardening": ("Session Hardening", "Turn observed session friction into improvements"),
}


def build(output):
    repo = Path(__file__).resolve().parent.parent
    source = repo / "plugins" / "unblock-roadmap"
    manifest = json.loads((source / "plugin.json").read_text())
    extension = manifest["extensions"]["com.openai"]
    interface = extension["interface"]
    assert manifest["name"] == "unblock-roadmap", "Preserve the existing package identity"
    assert manifest["$schema"] == "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json"
    assert re.fullmatch(r"\d+\.\d+\.\d+", manifest["version"])
    assert len(interface["displayName"]) <= 30
    assert len(interface["shortDescription"]) <= 30
    assert len(interface["longDescription"]) <= 4000
    assert interface["category"] == "Developer Tools"
    assert interface["defaultPrompt"] == "Unblock Roadmap", "Preserve the existing starter prompt"
    assert not manifest.get("apps") and not extension.get("apps")

    # Keep older Codex clients in sync with the portable source manifest.
    overlay = {key: manifest[key] for key in
               ("name", "version", "description", "author", "keywords")}
    overlay.update(interface=interface, skills="./skills")
    overlay["extensions"] = {"com.openai": {
        key: extension[key] for key in ("review", "publication") if key in extension
    }}
    files = {
        "plugin.json": (json.dumps(manifest, indent=2) + "\n").encode(),
        ".codex-plugin/plugin.json": (json.dumps(overlay, indent=2) + "\n").encode(),
    }
    for name in SKILLS:
        path = repo / "skills" / name / "public" / "SKILL.md"
        content = path.read_text()
        assert content.startswith(f"---\nname: {name}\n"), path
        assert "\ndescription: " in content.split("---", 2)[1], path
        assert len(content.encode()) <= 1024 * 1024, path
        for personal in ("/Users/jake", "~/.ai-tools", "Concentro", "jnelken/ai-tools", "fetch_file"):
            assert personal not in content, (path, personal)
        files[f"skills/{name}/SKILL.md"] = content.encode()
        label, summary = SKILL_LABELS[name]
        # JSON is valid YAML and avoids a build-time YAML dependency.
        agent = {"interface": {
            "display_name": label,
            "short_description": summary,
            "default_prompt": f"Use ${name} for this repository and the scope I specify.",
        }}
        files[f"skills/{name}/agents/openai.yaml"] = (json.dumps(agent, indent=2) + "\n").encode()

    # Assets are optional while drafting; submission readiness is tracked separately.
    assets = source / "assets"
    for key in ("logo", "composerIcon", "logoDark", "composerIconDark"):
        if key in interface:
            rel = Path(interface[key])
            assert not rel.is_absolute() and ".." not in rel.parts
            path = source / rel
            assert path.is_relative_to(assets) and path.is_file(), path
            assert path.stat().st_size <= 5 * 1024 * 1024
            files[rel.as_posix()] = path.read_bytes()

    output = output.resolve()
    assert not output.is_relative_to(source), "Write generated archives outside the source directory"
    output.parent.mkdir(parents=True, exist_ok=True)
    with zipfile.ZipFile(output, "w", compression=zipfile.ZIP_DEFLATED) as archive:
        for name, content in sorted(files.items()):
            entry = zipfile.ZipInfo(name, date_time=(2026, 1, 1, 0, 0, 0))
            entry.external_attr = 0o100644 << 16
            entry.compress_type = zipfile.ZIP_DEFLATED
            archive.writestr(entry, content)
    with zipfile.ZipFile(output) as archive:
        assert archive.testzip() is None
        assert set(archive.namelist()) == set(files)
        assert ".app.json" not in archive.namelist()
        for name in ("plugin.json", ".codex-plugin/plugin.json"):
            parsed = json.loads(archive.read(name))
            assert not parsed.get("apps")
            assert not parsed.get("extensions", {}).get("com.openai", {}).get("apps")
    print(f"Built {output}: {len(SKILLS)} skills, {len(files)} files, version {manifest['version']}")


if __name__ == "__main__":
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("output", type=Path, help="ZIP path outside the plugin source directory")
    build(parser.parse_args().output)
