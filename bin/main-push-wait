#!/usr/bin/env python3
"""Wait until a Koyeb app's last deploy is old enough to push (or merge) to main again.

Repos that auto-deploy on every push to main (internal-tools → Koyeb app `internal-tools`) space
pushes out so rollouts don't stack. The clock is when Koyeb last *started* a deploy, not when the
last commit was made: a commit's date says nothing about when it was pushed. On 2026-11-04 this
rule was enforced three times by hand with `sleep 1200` chains; run this before `git push` or
`gh pr merge` instead.

  main-push-wait                         # internal-tools, 20 minutes; sleeps, then exits 0
  main-push-wait --check                 # exit 0 if clear now, 1 if not (prints seconds left)
  main-push-wait --app other --minutes 10
"""
import argparse
from datetime import datetime, timezone
import json
import subprocess
import sys
import time


def last_deploy(app):
    """Newest deployment created_at for the app, as an aware datetime, or None if there are none."""
    result = subprocess.run(['koyeb', 'deployments', 'list', '--app', app, '-o', 'json'],
                            capture_output=True, text=True, check=True, timeout=60)
    data = json.loads(result.stdout)
    stamps = [d.get('created_at') for d in data.get('deployments', []) if d.get('created_at')]
    if not stamps:
        return None
    return max(datetime.fromisoformat(s.replace('Z', '+00:00')) for s in stamps)


def seconds_left(last, minutes, now=None):
    if last is None:
        return 0
    now = now or datetime.now(timezone.utc)
    return max(0, int(minutes * 60 - (now - last).total_seconds()))


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument('--app', default='internal-tools')
    parser.add_argument('--minutes', type=float, default=20)
    parser.add_argument('--check', action='store_true', help='report and exit instead of sleeping')
    args = parser.parse_args(argv)
    try:
        last = last_deploy(args.app)
    except (OSError, ValueError, subprocess.SubprocessError) as error:
        print(f'main-push-wait: could not read Koyeb deployments for {args.app}: {error}', file=sys.stderr)
        return 2
    left = seconds_left(last, args.minutes)
    stamp = last.strftime('%H:%M:%SZ') if last else 'none'
    if left == 0:
        print(f'main-push-wait: clear (last {args.app} deploy {stamp})')
        return 0
    print(f'main-push-wait: {left}s until {args.minutes:g} min after the last {args.app} deploy ({stamp})')
    if args.check:
        return 1
    time.sleep(left)
    print('main-push-wait: clear')
    return 0


if __name__ == '__main__':
    sys.exit(main())
