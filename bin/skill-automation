#!/bin/zsh
# Run an ai-tools skill headlessly. An automation is a schedule plus a skill name and nothing else:
# the skill owns the procedure and declares its own tool allowlist in its `allowed-tools`
# frontmatter, and --permission-mode dontAsk denies everything that allowlist does not cover.
#
#   skill-automation <skill> [--once-per day|week|month] [--force] [--model ID]
#
# --once-per  Skip when the skill already succeeded this period, so a scheduler can fire on several
#             days as a safety net. A run counts as succeeded only when the skill's output contains a
#             line `AUTOMATION_RESULT: ok ...` (the skill's "Unattended contract"); anything else
#             is retried at the next trigger.
# --force     Ignore the once-per marker.
#
# Runtime files: ~/.claude/automations/<skill>/{logs,state,cwd}. Safe to run by hand.
set -u

SKILL="${1:-}"
[ -n "$SKILL" ] && shift || { echo "usage: skill-automation <skill> [--once-per day|week|month] [--force] [--model ID]" >&2; exit 2; }

PERIOD=""; FORCE=0; MODEL="${SKILL_AUTOMATION_MODEL:-claude-sonnet-5-5}"
while [ $# -gt 0 ]; do
  case "$1" in
    --once-per) PERIOD="${2:-}"; shift 2 ;;
    --force)    FORCE=1; shift ;;
    --model)    MODEL="${2:-}"; shift 2 ;;
    *) echo "skill-automation: unknown argument $1" >&2; exit 2 ;;
  esac
done

# launchd gives a bare environment — set an explicit PATH so python3/git/node resolve.
export PATH="/opt/homebrew/bin:/opt/homebrew/opt/node@22/bin:/usr/bin:/bin:/usr/sbin:/sbin:$HOME/.local/bin"
CLAUDE="${CLAUDE_BIN:-$HOME/.local/bin/claude}"
ROOT="$HOME/.claude/automations/$SKILL"
mkdir -p "$ROOT/logs" "$ROOT/state" "$ROOT/cwd"

case "$PERIOD" in
  "")    KEY="" ;;
  day)   KEY="$(date +%F)" ;;
  week)  KEY="$(date +%G-W%V)" ;;
  month) KEY="$(date +%Y-%m)" ;;
  *) echo "skill-automation: --once-per takes day|week|month" >&2; exit 2 ;;
esac
MARKER="${KEY:+$ROOT/state/$KEY.done}"
[ -n "$MARKER" ] && [ -e "$MARKER" ] && [ "$FORCE" -eq 0 ] && exit 0

LOG="$ROOT/logs/run-$(date +%Y%m%d-%H%M%S).log"
find "$ROOT/logs" -name 'run-*.log' -mtime +90 -delete 2>/dev/null
ln -sf "$LOG" "$ROOT/logs/latest.log"

{
  echo "=== skill-automation $SKILL ($(date)) model=$MODEL period=${PERIOD:-none} ==="
  [ -x "$CLAUDE" ] || { echo "FATAL: claude not found at $CLAUDE"; exit 1; }
  [ -f "$HOME/.claude/skills/$SKILL/SKILL.md" ] || { echo "FATAL: no installed skill named $SKILL"; exit 1; }

  OUT="$(cd "$ROOT/cwd" && "$CLAUDE" -p "/$SKILL unattended" \
    --model "$MODEL" --permission-mode dontAsk --output-format text < /dev/null)"
  rc=$?
  echo "$OUT"

  if [ "$rc" -eq 0 ] && printf '%s\n' "$OUT" | grep -q '^AUTOMATION_RESULT: ok'; then
    [ -n "$MARKER" ] && : > "$MARKER"
    osascript -e "display notification \"$SKILL finished\" with title \"Automation\"" 2>/dev/null || true
    echo "=== ok $(date) ==="
  else
    echo "=== NOT ok (exit=$rc, no AUTOMATION_RESULT: ok line); no marker written, next trigger retries ==="
    exit 1
  fi
} >> "$LOG" 2>&1
